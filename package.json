{
  "name": "dsh-px",
  "version": "0.1.0-beta.re.0.11",
  "private": true,
  "description": "DSH-PX: a local Windows agent desktop built on DeepSeek Harness plugins.",
  "license": "MIT",
  "author": "Palbudir",
  "main": "out/main/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palbudir/dsh-px.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/run.mjs repair-electron",
    "build": "npm run build:plugins && npm run build:main",
    "build:main": "electron-vite build && node scripts/run.mjs write-build-info",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:plugin-host": "node scripts/build-plugins.mjs --host",
    "build:plugin-client": "node scripts/build-plugins.mjs --client",
    "test": "npm run build:plugins && node scripts/run-tests.mjs",
    "dev": "node scripts/dev.mjs",
    "stage": "node scripts/run.mjs stage-runtime",
    "stage:plugins": "node scripts/run.mjs stage-runtime --with-plugins",
    "verify": "node scripts/run.mjs verify-capabilities",
    "verify:package": "node scripts/run.mjs verify-package",
    "prune": "node scripts/run.mjs prune-seed-home",
    "icon": "node scripts/run.mjs build-icon",
    "screenshot": "node scripts/run.mjs screenshot-app",
    "start": "node scripts/dev.mjs",
    "pack": "npm run build && npm run stage -- --with-plugins && node scripts/run.mjs check-entry-artifacts && electron-builder --dir && node scripts/run.mjs write-app-update-yml",
    "dist": "npm run build && npm run stage -- --with-plugins && npm run prune && node scripts/run.mjs check-entry-artifacts && electron-builder --publish never && npm run verify:package",
    "clean": "node -e \"require('node:fs').rmSync('runtime',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "check:plugins": "node scripts/check-plugins.mjs",
    "format": "prettier --write src packages scripts test config .github docs \"*.json\" \"*.md\"",
    "format:check": "prettier --check src packages scripts test config .github docs \"*.json\" \"*.md\"",
    "audit:logs": "node scripts/run.mjs analyze-quality",
    "maintenance:backups": "node scripts/run.mjs manage-backups",
    "maintenance:qa": "node scripts/run.mjs archive-qa",
    "check:repo": "npm run check:plugins && npm run check:docs && npm run format:check",
    "check:docs": "node scripts/check-docs.mjs",
    "review:install": "node scripts/review-install.mjs",
    "review:worker": "node scripts/review-worker.mjs",
    "quality": "node scripts/release-quality.mjs",
    "check:catalog": "node scripts/release-catalog.mjs",
    "review:smoke": "node scripts/review-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.9",
    "semver": "^7.8.5",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.palbudir.dshpx",
    "productName": "DSH-PX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "build/tray-32.png",
        "to": "tray-32.png"
      },
      {
        "from": "build/tray-16.png",
        "to": "tray-16.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH-PX",
      "uninstallDisplayName": "DSH-PX"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Palbudir",
        "repo": "dsh-px",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
