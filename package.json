{
  "name": "dsh-px",
  "version": "0.1.0-beta.re.0.1",
  "private": true,
  "description": "dsh-px: a self-contained Electron desktop client that packages DeepSeek Harness (dsh) into one app.",
  "license": "MIT",
  "author": "Palbudir",
  "main": "out/main/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palbudir/dsh-px.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/repair-electron.mjs",
    "build": "npm run build:plugins && npm run build:main",
    "build:main": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "//build:plugins": "自研插件的两个半边都是**预构建产物**（lib/index.js、lib/client.js），入库交付。宿主半边先构建：它决定 lib/ 是否完整。",
    "build:plugins": "npm run build:plugin-host && npm run build:plugin-client",
    "build:plugin-host": "node packages/dsh-px-updater/scripts/build-host.mjs",
    "build:plugin-client": "node packages/dsh-px-updater/scripts/build-client.mjs",
    "test": "npm run build:plugins && esbuild test/**/*.test.ts --bundle --platform=node --format=esm --packages=external --outdir=build-test --log-level=warning && node --test build-test/*.test.js",
    "dev": "npm run build && electron out/main/index.js",
    "stage": "node scripts/stage-runtime.mjs",
    "stage:plugins": "node scripts/stage-runtime.mjs --with-plugins",
    "verify": "node scripts/verify-capabilities.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prune": "node scripts/prune-seed-home.mjs",
    "icon": "node scripts/build-icon.mjs",
    "start": "npm run build && electron out/main/index.js",
    "pack": "npm run build && electron-builder --dir && node scripts/write-app-update-yml.mjs",
    "dist": "npm run build && npm run prune && electron-builder --publish never && node scripts/verify-package.mjs",
    "clean": "node -e \"require('node:fs').rmSync('runtime',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('out',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.palbudir.dshpx",
    "productName": "DSH-PX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "build/tray-32.png",
        "to": "tray-32.png"
      },
      {
        "from": "build/tray-16.png",
        "to": "tray-16.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH-PX"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Palbudir",
        "repo": "dsh-px",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
