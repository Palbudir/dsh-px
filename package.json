{
  "name": "dsh-px",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "dsh-px: a self-contained Electron desktop client that packages DeepSeek Harness (dsh) into one app.",
  "license": "MIT",
  "author": "Palbudir",
  "main": "app/main.mjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palbudir/dsh-px.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/repair-electron.mjs",
    "stage": "node scripts/stage-runtime.mjs",
    "stage:plugins": "node scripts/stage-runtime.mjs --with-plugins",
    "verify": "node scripts/verify-capabilities.mjs",
    "start": "electron app/main.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "clean": "node -e \"require('node:fs').rmSync('runtime',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.palbudir.dshpx",
    "productName": "DSH-PX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH-PX"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
