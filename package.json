{
  "name": "dsh-px",
  "version": "0.8.0-alpha.1",
  "private": true,
  "description": "DSH-PX: a native DeepSeek Harness plugin Pack and an official-source derived Windows Desktop.",
  "license": "MIT",
  "author": "Palbudir",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palbudir/dsh-px.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:plugins",
    "build:pack": "node scripts/run.mjs build-native-pack",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:plugin-host": "node scripts/build-plugins.mjs --host",
    "build:plugin-client": "node scripts/build-plugins.mjs --client",
    "test": "npm run build:plugins && node scripts/run-tests.mjs",
    "icon": "node scripts/run.mjs build-icon",
    "check:plugins": "node scripts/check-plugins.mjs",
    "format": "prettier --write src packages scripts test config .github docs \"*.json\" \"*.md\"",
    "format:check": "prettier --check src packages scripts test config .github docs \"*.json\" \"*.md\"",
    "check:repo": "npm run check:plugins && npm run check:docs && npm run check:secrets && npm run format:check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "quality": "node scripts/release-quality.mjs",
    "check:roadmap": "node scripts/check-roadmap.mjs"
  },
  "overrides": {
    "zod@4.4.3": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "dsh-mnemon": "0.5.34",
    "dsh-mnemon-source-documents": "0.5.11",
    "dsh-mnemon-source-skills": "0.5.1",
    "electron-updater": "6.8.9",
    "esbuild": "^0.25.12",
    "marked": "16.4.2",
    "postcss": "8.5.30",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
